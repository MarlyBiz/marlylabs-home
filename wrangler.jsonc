{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marlylabs-home",
  "compatibility_date": "2026-11-09",
  "assets": { "directory": "./dist" },
  "routes": [
    { "pattern": "marlylabs.app", "custom_domain": true },
    { "pattern": "www.marlylabs.app", "custom_domain": true }
  ],
  "workers_dev": false
}
